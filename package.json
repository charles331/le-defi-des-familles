{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "build": "vite build && node --import tsx scripts/compress-dist.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "start": "NODE_ENV=production node --enable-source-maps build/server.cjs",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "audit:questions": "node --import tsx scripts/audit-questions.ts",
    "audit:doublons": "node --import tsx scripts/find-duplicate-facts.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "analyze:difficulty": "node --import tsx scripts/analyze-difficulty.ts",
    "assets:brand": "node --import tsx scripts/render-brand-assets.ts",
    "check": "npm run lint && npm run build && npm test && npm run audit:questions",
    "score:fun": "node --import tsx scripts/score-fun.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.2.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vite": "^6.4.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.7.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "@types/express": "^4.17.25"
  }
}
