## Adresse publique du jeu, sans chemin (ex. https://jeu.example.be).
## Recommandee en production : c'est elle qu'annoncent les apercus de lien
## (og:image). Sans elle, on retombe sur l'en-tete Host de la requete, valide
## mais choisi par le client.
PUBLIC_ORIGIN=

## Inutile a definir : `npm start` pose NODE_ENV=production, et le serveur le
## suppose par defaut. Seul `npm run dev` passe en developpement (Vite, sans CSP).
# NODE_ENV=

## Fournisseur utilisé par le générateur de thèmes : "openai" (défaut) ou
## "gemini". Changer cette seule variable bascule sans modifier le code.
AI_PROVIDER=openai

# Requis avec AI_PROVIDER=openai (défaut).
OPENAI_API_KEY=

# Facultatif. Modèle OpenAI utilisé pour générer les packs.
# Par défaut : gpt-5.4-mini, dont le palier gratuit quotidien du compte
# (2,5 millions de tokens) couvre une centaine de thèmes. gpt-5.4 écrit de
# meilleures cartes mais n'en a que 250 000 (une dizaine de thèmes) : le
# choisir, c'est aussi régler MAX_AI_TOKENS_PER_DAY=200000.
OPENAI_MODEL=

# Facultatif. Par défaut : low (écrire des cartes ne demande pas de longue
# réflexion, et les tokens de raisonnement sont facturés). Valeurs possibles
# selon le modèle : none, low, medium, high.
OPENAI_REASONING_EFFORT=

# Facultatif. Tokens que le fournisseur peut facturer par jour (UTC), toutes
# générations confondues, d'après ce qu'il déclare à chaque réponse. Au-delà,
# le générateur répond « limite du jour » jusqu'au lendemain : c'est ce qui
# garde le jeu dans le palier gratuit. Par défaut : 2000000 (gpt-5.4-mini).
MAX_AI_TOKENS_PER_DAY=

# Facultatif. Plafond de générations de thèmes par jour (UTC), tous salons et
# toutes adresses confondus. Par défaut : 200. 0 coupe la génération.
# Les deux compteurs sont gardés dans DATA_DIR s'il est défini, sinon en mémoire.
MAX_GENERATIONS_PER_DAY=

# Requis uniquement avec AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Facultatif. Modèle Gemini. Par défaut : gemini-2.5-flash, retiré de l'API le
# 16/10/2026 : avec Gemini, définir GEMINI_MODEL (gemini-3.5-flash sur un
# palier payant ; son quota gratuit, 5 requêtes/minute, ne passe pas les lots
# parallèles d'une génération).
GEMINI_MODEL=

# Facultatif. Le jeu fonctionne sans : les serveurs STUN publics suffisent dans
# la grande majorite des cas, y compris entre deux box internet differentes. Un
# relais TURN ne devient necessaire que pour les reseaux qui refusent la
# connexion directe (NAT symetrique, 4G/5G de certains operateurs, Wi-Fi
# d'entreprise). Sans TURN, l'echec est signale aux joueurs concernes et la
# partie continue normalement.
#
# Pour en obtenir un : Cloudflare propose un service TURN gere (Cloudflare
# Realtime) qui fournit une URL et des identifiants a coller ci-dessous ;
# verifiez ses quotas et tarifs actuels avant de vous en servir. D'autres
# hebergeurs TURN geres existent, et coturn s'auto-heberge sur un petit VPS.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Persistance des parties (aucune base de données requise).
# Sur Railway : créez un Volume, montez-le sur /data, puis DATA_DIR=/data.
# Sans volume, les parties survivent aux redémarrages du processus mais pas
# au remplacement du conteneur.
DATA_DIR=

# Fenetre de conservation d un salon mis en pause (4 h par defaut).
ROOM_PAUSED_TTL_MS=
